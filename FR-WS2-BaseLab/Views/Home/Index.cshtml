@model IEnumerable<FR_WS2_BaseLab.Models.Category>
@{
    ViewData["Title"] = "Home Page";
}
<a class="btn btn-success" asp-controller="Categories" asp-action="Create">Create Category</a>
<div class="row justify-content-around">
    @foreach (var item in Model)
    {
        <div class="card" style="width: 18rem;">
            <div class="card-body">
                <h5 class="card-title">@item.Name</h5>
                <h6 class="card-subtitle mb-2 text-body-secondary">@item.Topics.Count</h6>
                <p class="card-text">@item.Description</p>
                <div>IMAGES</div>
                @foreach(var t in item.Topics)
                {
                    <a asp-controller="Topics" asp-action="Details" asp-route-id="@t.Id">@t.Title</a>
                }
                <a asp-controller="Topics" asp-action="Index" asp-route-id="@item.Id" class="btn btn-secondary">Topics</a>
            </div>
        </div>
    }
</div>

